{
  "expo": {
    "name": "Servigic Pro",
    "slug": "xpertserviz-786",
    "scheme": "servigic-pro",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0808",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.servigic.pro",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Servigic Pro shares your location with the customer while you're on the way to a job.",
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.servigic.pro",
      "adaptiveIcon": {
        "backgroundColor": "#0A0808",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDUNVlPXrrOVsSpwQ59KQQ8t8QnqLalrAg"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Servigic Pro shares your location with the customer while you're on the way to a job."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Servigic Pro needs access to your photos to upload verification documents."
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false
        }
      ],
      "expo-font",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0808",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F5A623",
          "sounds": [
            "./assets/sounds/new_job_alert.wav",
            "./assets/sounds/bid_accepted.wav",
            "./assets/sounds/message_received.wav",
            "./assets/sounds/job_status_update.wav",
            "./assets/sounds/job_done.wav",
            "./assets/sounds/payment_added.wav"
          ]
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "userTrackingPermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1246e66a-5239-44e4-9021-4dc3f1dd590c"
      }
    },
    "owner": "xpertserviz-786",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1246e66a-5239-44e4-9021-4dc3f1dd590c"
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-3940256099942544~3347511713",
    "delay_app_measurement_init": false,
    "optimize_initialization": true,
    "optimize_ad_loading": true
  }
