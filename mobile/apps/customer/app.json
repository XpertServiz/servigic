{
  "expo": {
    "name": "Servigic",
    "slug": "servigic-customer",
    "scheme": "servigic-customer",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0808",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.servigic.customer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Servigic uses your location to set the job's location and find nearby pros."
      },
      "config": {}
    },
    "android": {
      "package": "com.servigic.customer",
      "versionCode": 33,
      "adaptiveIcon": {
        "backgroundColor": "#0A0808",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDUNVlPXrrOVsSpwQ59KQQ8t8QnqLalrAg"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Servigic uses your location to set the job's location and find nearby pros."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Servigic needs access to your photos to attach job photos and payment proof."
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# --- Servigic release rules (R8). Kept deliberately small; the libraries ship their own consumer rules too. ---\n# Crash reports stay readable once the mapping file is uploaded.\n-keepattributes SourceFile,LineNumberTable,*Annotation*,Signature,InnerClasses,EnclosingMethod\n-renamesourcefileattribute SourceFile\n# Expo modules and Kotlin metadata are read by reflection.\n-keep class expo.modules.** { *; }\n-keep class kotlin.Metadata { *; }\n# Google Mobile Ads (AdMob) and its React Native bridge.\n-keep class io.invertase.googlemobileads.** { *; }\n-keep class com.google.android.gms.ads.** { *; }\n-dontwarn com.google.android.gms.ads.**\n# Firebase Cloud Messaging (push) and Google Play services.\n-keep class com.google.firebase.messaging.** { *; }\n-keep class com.google.firebase.iid.** { *; }\n-keep class com.google.firebase.installations.** { *; }\n-keep class com.google.android.gms.common.** { *; }\n-dontwarn com.google.firebase.**\n-dontwarn com.google.android.gms.**\n# Maps\n-keep class com.rnmaps.** { *; }\n-keep class com.google.android.gms.maps.** { *; }\n# Networking libraries that reference optional classes\n-dontwarn okhttp3.**\n-dontwarn okio.**\n"
          }
        }
      ],
      "./plugins/withKeepRawResources",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0808",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F5A623",
          "sounds": [
            "./assets/sounds/new_job_alert.wav",
            "./assets/sounds/bid_accepted.wav",
            "./assets/sounds/message_received.wav",
            "./assets/sounds/job_status_update.wav",
            "./assets/sounds/job_done.wav",
            "./assets/sounds/payment_added.wav",
            "./assets/sounds/new_bid.wav",
            "./assets/sounds/booking_progress.wav",
            "./assets/sounds/first_bid_ar.ogg",
            "./assets/sounds/first_bid_de.ogg",
            "./assets/sounds/first_bid_en.ogg",
            "./assets/sounds/first_bid_es.ogg",
            "./assets/sounds/first_bid_fr.ogg",
            "./assets/sounds/first_bid_hi.ogg",
            "./assets/sounds/first_bid_pa.ogg",
            "./assets/sounds/first_bid_ur.ogg",
            "./assets/sounds/pro_arrived_ar.ogg",
            "./assets/sounds/pro_arrived_de.ogg",
            "./assets/sounds/pro_arrived_en.ogg",
            "./assets/sounds/pro_arrived_es.ogg",
            "./assets/sounds/pro_arrived_fr.ogg",
            "./assets/sounds/pro_arrived_hi.ogg",
            "./assets/sounds/pro_arrived_pa.ogg",
            "./assets/sounds/pro_arrived_ur.ogg",
            "./assets/sounds/pro_on_the_way_ar.ogg",
            "./assets/sounds/pro_on_the_way_de.ogg",
            "./assets/sounds/pro_on_the_way_en.ogg",
            "./assets/sounds/pro_on_the_way_es.ogg",
            "./assets/sounds/pro_on_the_way_fr.ogg",
            "./assets/sounds/pro_on_the_way_hi.ogg",
            "./assets/sounds/pro_on_the_way_pa.ogg",
            "./assets/sounds/pro_on_the_way_ur.ogg",
            "./assets/sounds/request_sent_ar.ogg",
            "./assets/sounds/request_sent_de.ogg",
            "./assets/sounds/request_sent_en.ogg",
            "./assets/sounds/request_sent_es.ogg",
            "./assets/sounds/request_sent_fr.ogg",
            "./assets/sounds/request_sent_hi.ogg",
            "./assets/sounds/request_sent_pa.ogg",
            "./assets/sounds/request_sent_ur.ogg"
          ]
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713"
        }
      ]
    ],
    "owner": "xpertserviz-786",
    "extra": {
      "eas": {
        "projectId": "33d8f4e9-8c36-4a3d-a933-22ef65847614"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/33d8f4e9-8c36-4a3d-a933-22ef65847614"
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-3940256099942544~3347511713",
    "delay_app_measurement_init": false,
    "optimize_initialization": true,
    "optimize_ad_loading": true
  }
}
