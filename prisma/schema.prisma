// Servigic — Prisma schema (Master Brief v1.1 §6)
// Postgres via Supabase (or local Postgres for dev — see docker-compose.yml)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
  SUPPORT
}

enum Language {
  en
  ur
  ar
  de
  fr
  pl
  // Added for the mobile apps' language picker (machine-translated at launch).
  hi
  es
}

// Display-only currencies (Master Brief §11 / GCC_EXPANSION.md). Every
// transactional amount in this schema (Job.budgetPKR, Bid.pricePKR,
// Booking.totalPKR, etc.) stays in PKR — these are for converting PKR
// figures into an approximate local-currency figure for browsing/SEO
// display only, since no non-PKR payment gateway is wired yet.
enum Currency {
  PKR
  USD
  CAD
  EUR
  PLN
  SAR
  AED
  QAR
}

enum Trade {
  PLUMBER
  ELECTRICIAN
  AC_TECHNICIAN
  SOLAR_INSTALLER
  CARPENTER
  PAINTER
  APPLIANCE_REPAIR
  CAR_MECHANIC
  MOVERS
  CLEANER
  MASON
  HANDYMAN
  PEST_CONTROL
  ROOFING
  LOCKSMITH
  GARDENING
  TILING
  GENERATOR_REPAIR
  WATER_TANK_CLEANING
  GLASS_REPAIR
  WELDING
  UPHOLSTERY
}

enum PayoutMethod {
  EASYPAISA
  JAZZCASH
  BANK
}

enum Urgency {
  EMERGENCY
  TODAY
  SCHEDULED
}

enum JobStatus {
  OPEN
  BOOKED
  IN_PROGRESS
  COMPLETED
  EXPIRED
  CANCELLED
  DISPUTED
}

enum BidStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  COUNTERED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  ON_MY_WAY
  ARRIVED
  WORKING
  DONE
  COMPLETED
  CANCELLED
  EXPIRED
  DISPUTED
}

enum MatchType {
  BID
  INSTANT
}

enum PlanFrequency {
  MONTHLY
  QUARTERLY
  BIANNUAL
}

enum PlanStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum PaymentMethod {
  JAZZCASH
  EASYPAISA
  BANK_TRANSFER
  CARD
}

enum PaymentStatus {
  SUBMITTED
  VERIFIED
  REJECTED
}

enum PayoutStatus {
  QUEUED
  SENT
  CONFIRMED
  FAILED
}

// Cash-After-Job Payment Model + Anti-Bypass System (v6+v7 addendum)
enum WalletDispatchStatus {
  NORMAL
  WARNED
  THROTTLED
  SUSPENDED
}

enum LedgerEntryType {
  COMMISSION_DEBIT
  TOPUP_CREDIT
  ADJUSTMENT
  REFERRAL_BONUS
  DISCOUNT_CREDIT // Servigic-funded customer discount paid into the pro wallet
}

enum TopUpStatus {
  SUBMITTED
  VERIFIED
  REJECTED
}

enum CancelledByRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum CancellationReasonCode {
  CUSTOMER_CHANGED_MIND
  CUSTOMER_FOUND_ANOTHER_PRO
  CUSTOMER_PRICE_TOO_HIGH
  // Special chip — customer-side only; excluded from the customer's own
  // rate and auto-flags the pro for admin review (v7 §2.3).
  CUSTOMER_PRO_ASKED_TO_CANCEL
  PROVIDER_UNAVAILABLE
  PROVIDER_JOB_TOO_FAR
  PROVIDER_PRICE_DISPUTE
  OTHER
}

enum FlagType {
  COLLUSION_ACCEPT_CANCEL_PAIR
  COLLUSION_REBOOK_AVOIDANCE
  CONTACT_LEAKAGE_ATTEMPTS
  MANUAL_ADMIN
}

enum FlagStatus {
  OPEN
  DISMISSED
  WARNED
  SUSPENDED
  DELISTED
}

enum LeadSource {
  GOOGLE_PLACES
  MANUAL
  REFERRAL
  WAITLIST
  APP
  IMPORT
  PRO_REFERRAL
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  ONBOARDED // legacy: treated as REGISTERED
  NOT_INTERESTED
  CALLBACK
  INVITED
  REGISTERED
  VERIFIED
  ACTIVE
  WRONG_NUMBER
  DO_NOT_CONTACT
}

enum DisputeResolution {
  RELEASE
  PARTIAL_REFUND
  FULL_REFUND
}

enum NotificationType {
  DISPATCH_ALERT
  BID_RECEIVED
  BID_ACCEPTED
  BID_DECLINED
  BID_COUNTERED
  PAYMENT_VERIFIED
  STATUS_UPDATE
  JOB_COMPLETED
  PAYOUT_SENT
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  SYSTEM
}

// ─────────────────────────────────────────────────────────────────────────
// Core
// ─────────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  role          Role     @default(CUSTOMER)
  name          String
  email         String?
  phone         String
  phoneVerified Boolean  @default(false)
  passwordHash  String
  // Staff level for ADMIN accounts: super_admin | growth_admin may export and see full phone numbers; admin sees masked numbers and cannot export.
  adminLevel    String   @default("super_admin")
  avatarUrl     String?
  city          String?
  language      Language @default(en)
  fcmTokens     String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  providerProfile ProviderProfile?

  jobsPosted              Job[]             @relation("CustomerJobs")
  bookingsAsCustomer      Booking[]         @relation("CustomerBookings")
  bookingsAsProvider      Booking[]         @relation("ProviderBookings")
  bids                    Bid[]
  reviewsGiven            Review[]          @relation("ReviewAuthor")
  reviewsReceived         Review[]          @relation("ReviewTarget")
  customerReviewsGiven    CustomerReview[]  @relation("CustomerReviewAuthor")
  customerReviewsReceived CustomerReview[]  @relation("CustomerReviewTarget")
  messages                Message[]
  notifications           Notification[]
  disputesOpened          Dispute[]         @relation("DisputeOpener")
  otpCodes                OtpCode[]
  journalEntriesPosted    JournalEntry[]    @relation("JournalEntryPoster")
  changeOrdersProposed    ChangeOrder[]     @relation("ChangeOrderProposer")
  maintenancePlans        MaintenancePlan[] @relation("MaintenancePlanCustomer")
  cancellationEventsCaused CancellationEvent[] @relation("CancellationActor")
  rewardCredits            RewardCredit[]
  termsAcceptances         TermsAcceptance[]
  flagsAsCustomer          ProviderFlag[]      @relation("ProviderFlagCustomer")
  // Anti-bypass anti-collusion tracking (v7 §2.3) — customer side of the
  // same rolling-30-day cancellation-rate mechanic ProviderProfile has.
  cancellationRate30d      Float               @default(0)
  cancellationCount30d     Int                 @default(0)
  postingPaused            Boolean             @default(false) // >=5 cancels/30d — job-posting paused pending review
  // Admin-posted jobs: a placeholder customer account created by an admin from a phone number. It has
  // no usable password; when the real customer registers with the same phone, the register details wait
  // in the pending* fields until the phone OTP is verified, then the account is claimed (job history kept).
  managedByAdmin           Boolean             @default(false)
  // Referrals: this user's shareable code, and the device they signed up on (abuse checks).
  referralCode             String?             @unique
  signupDeviceId           String?
  pendingPasswordHash      String?
  pendingName              String?
  pendingEmail             String?

  @@index([role])
  @@index([city])
  @@index([signupDeviceId])

  // The same phone number may hold one customer and one pro account (same person, two roles).
  @@unique([phone, role])
  @@unique([email, role])
}

model OtpCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String
  purpose    String    @default("PHONE_VERIFY")
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model ProviderProfile {
  tradeRequests ProviderTrade[]
  documents     ProviderDocument[]
  // Founding Pro: reduced commission until this date, then the standard rate again (see src/lib/foundingPro.ts)
  foundingUntil           DateTime?
  foundingEndNotifiedAt   DateTime?

  id                  String        @id @default(cuid())
  userId              String        @unique
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName         String
  serialNumber        Int           @unique @default(autoincrement())
  trades              Trade[]       @default([])
  skillsNote          String?
  serviceRadiusKm     Int           @default(5)
  baseLat             Float?
  baseLng             Float?
  geohash             String?
  isOnline            Boolean       @default(false)
  verificationLevel   Int           @default(0) // 0 unverified, 1 approved, 2 verified pro, 3 gold ustad
  cnicUrl             String?
  selfieUrl           String?
  photoQualityOk      Boolean       @default(false) // Provider Photo Standardization Addendum v3 — set automatically at upload time (square crop + min resolution passed), never by manual review
  policeCertUrl       String?
  isVerified          Boolean       @default(false)
  verifiedAt          DateTime?
  // Explicit opt-in, defaults off — a pro's selfie only ever appears on the
  // public landing page/reviews if they actively consented, captured with
  // a timestamp for compliance. Never inferred from verificationLevel.
  photoConsentPublic  Boolean       @default(false)
  photoConsentAt      DateTime?
  ratingAvg           Float         @default(0)
  ratingCount         Int           @default(0)
  jobsCompleted       Int           @default(0)
  payoutMethod        PayoutMethod?
  payoutAccount       String?
  commissionPct       Float         @default(12)
  agreementAcceptedAt DateTime?
  // Cash-After-Job Payment Model + Anti-Bypass System (v6+v7 addendum).
  // Single source of truth for dispatch eligibility — computed by
  // src/lib/providerStanding.ts from the max of wallet-debt severity and
  // cancellation-rate severity, so src/lib/dispatch.ts only checks this
  // one field rather than two independent ones.
  dispatchStatus       WalletDispatchStatus @default(NORMAL)
  dispatchBlockedReason String?             // "WALLET_CEILING" | "WALLET_UNSETTLED_JOBS" | "CANCELLATION_RATE" | "ADMIN_FLAG" | null
  suspendedUntil       DateTime?            // only set for the cancellation-rate 48h penalty; wallet-ceiling block has no expiry (cleared by topping up)
  cancellationRate30d  Float                @default(0)
  cancellationCount30d Int                  @default(0)
  // Opt-in rewarded-ad perk (mobile Pro app): while in the future, the pro's
  // effective service radius is widened (see BOOST_RADIUS_MULTIPLIER in
  // src/lib/dispatch.ts) so they see/are alerted to more jobs for ~1 hour.
  visibilityBoostUntil DateTime?
  // Verification review (OCR-assisted manual review). The OCR output is only a
  // convenience for the reviewer - approval is always a human action.
  cnicOcr                 Json?     // { fullName, idNumber, dob, address, rawLines } extracted on-device (ML Kit)
  verificationSubmittedAt DateTime? // when the last complete CNIC+selfie submission arrived (SLA clock)
  verificationEscalatedAt DateTime? // set once the 24h SLA reminder went to the admins
  verificationReviewedAt  DateTime?
  verificationReviewedById String?
  verificationRejectedAt  DateTime?
  verificationRejectedReason String?
  // Supply/demand balance (handoff §11.4). WAITING = approved but the pro's
  // market/trade is not open yet or is at its admin-set cap; they get no job
  // alerts and cannot bid until activated (FIFO by waitingSince).
  activation              ProActivation @default(ACTIVE)
  waitingSince            DateTime?
  activatedAt             DateTime?
  // Early-pro incentives: granted when activated while their market is PILOT.
  foundingPro             Boolean       @default(false)
  commissionFreeJobsLeft  Int           @default(0)
  // Job-alert controls (handoff §11.5). Quiet hours are minutes after local
  // midnight in the market's timezone; a window may wrap midnight.
  alertsPaused            Boolean       @default(false)
  // Job-alert EMAIL to this pro while offline (free Resend plan, budget-capped in src/lib/emailBudget.ts). Pros can opt out.
  emailAlerts             Boolean       @default(true)
  alertQuietStartMin      Int?
  alertQuietEndMin        Int?
  alertDailyCap           Int           @default(30)
  // Working hours: several windows per weekday ({ mon: [{ start, end }], ... }, minutes after local midnight). null = always available.
  availability            Json?
  // Set while a mandatory document has expired past its grace period: no job alerts or bids until a renewed one is approved.
  documentsBlockedAt      DateTime?
  documentsBlockedReason  String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  bids              Bid[]
  bookings          Booking[]         @relation("ProviderProfileBookings")
  payouts           Payout[]
  preferredForPlans MaintenancePlan[]
  wallet            ProWallet?
  flags             ProviderFlag[]
  preferredForJobs  Job[]             @relation("JobPreferredProvider")

  @@index([geohash])
  @@index([isOnline])
  @@index([isVerified])
}

model ServiceCategory {
  id           String   @id @default(cuid())
  trade        Trade    @unique
  name         String
  slug         String   @unique
  icon         String
  description  String?
  activeCities String[] @default([])
  minPricePKR  Int?
  maxPricePKR  Int?
  createdAt    DateTime @default(now())

  subServices      SubService[]
  jobs             Job[]
  priceBenchmarks  PriceBenchmark[]
  maintenancePlans MaintenancePlan[]
}

model SubService {
  id          String          @id @default(cuid())
  categoryId  String
  category    ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  active      Boolean         @default(true)
  minPricePKR Int?
  maxPricePKR Int?

  jobs            Job[]
  priceBenchmarks PriceBenchmark[]

  @@unique([categoryId, slug])
}

// Nightly-recomputed cache of real winning-bid price ranges per
// (category, subService?, city, window) — Competitive Edge Addendum §2.1.
// Rebuilt wholesale on each recompute (delete-then-insert), never partially
// upserted, so a row existing here always means it met MIN_SAMPLE_SIZE.
model PriceBenchmark {
  id               String          @id @default(cuid())
  categoryId       String
  category         ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subServiceId     String?
  subService       SubService?     @relation(fields: [subServiceId], references: [id], onDelete: Cascade)
  city             String
  windowDays       Int
  sampleSize       Int
  avgWinningPKR    Int
  medianWinningPKR Int
  minPKR           Int
  maxPKR           Int
  updatedAt        DateTime        @updatedAt

  @@index([categoryId, city, windowDays])
}

// Recurring service subscriptions (AC servicing, generator checkup, water
// tank cleaning) — Competitive Edge Addendum §2.6. Reuses the existing
// Job/Booking/bidding pipeline entirely: each due cycle just creates a
// normal Job (pricePerVisitPKR seeds that Job's budgetPKR as a starting
// estimate, not a fixed charge — the job still goes through real bidding
// or Instant Match like any other job).
model MaintenancePlan {
  id                  String           @id @default(cuid())
  customerId          String
  customer            User             @relation("MaintenancePlanCustomer", fields: [customerId], references: [id])
  categoryId          String
  category            ServiceCategory  @relation(fields: [categoryId], references: [id])
  city                String
  areaLabel           String
  exactAddress        String
  lat                 Float
  lng                 Float
  frequency           PlanFrequency
  preferredProviderId String?
  preferredProvider   ProviderProfile? @relation(fields: [preferredProviderId], references: [id])
  pricePerVisitPKR    Int
  nextDueDate         DateTime
  status              PlanStatus       @default(ACTIVE)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  visits PlanVisit[]

  @@index([status, nextDueDate])
  @@index([customerId])
}

model PlanVisit {
  id            String          @id @default(cuid())
  planId        String
  plan          MaintenancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  scheduledDate DateTime
  jobId         String?         @unique
  job           Job?            @relation(fields: [jobId], references: [id])
  createdAt     DateTime        @default(now())

  @@index([planId])
}

model Job {
  id              String          @id @default(cuid())
  customerId      String
  customer        User            @relation("CustomerJobs", fields: [customerId], references: [id])
  categoryId      String
  category        ServiceCategory @relation(fields: [categoryId], references: [id])
  subServiceId    String?
  subService      SubService?     @relation(fields: [subServiceId], references: [id])
  title           String
  description     String
  photos          String[]        @default([])
  // One optional short video of the problem (uploaded straight to UploadThing, see src/lib/mediaLimits.ts).
  videoUrl        String?
  // When the job's photos/video were deleted from storage (24 h after the job ended).
  mediaDeletedAt  DateTime?
  urgency         Urgency         @default(TODAY)
  scheduledAt     DateTime?
  // Scheduled jobs: length of the arrival window from scheduledAt (60 = one hour; a whole day for "any time that day"),
  // and which reminder was last sent ("24h" the day before, "1h" an hour before).
  scheduledWindowMins Int?
  scheduleReminder    String?
  city            String
  areaLabel       String
  exactAddress    String
  lat             Float
  lng             Float
  geohash         String
  budgetPKR       Int?
  status          JobStatus       @default(OPEN)
  biddingClosesAt DateTime
  // v7 §2.5 "Book [Pro] again" — when set, dispatchJob() sends the alert
  // only to this provider (a private one-tap invite) instead of the normal
  // trade/city/radius fan-out. Precedented by MaintenancePlan.preferredProviderId.
  preferredProviderId String?
  preferredProvider   ProviderProfile? @relation("JobPreferredProvider", fields: [preferredProviderId], references: [id])
  // Customer-widened search (handoff §11.2): extra km added to every pro's
  // service radius for this job only.
  extraRadiusKm       Int             @default(0)
  noBidsNotifiedAt    DateTime?
  // When the customer was warned that the request closes soon without a chosen pro.
  expiryWarnedAt      DateTime?
  // Set when an admin posted this job on a customer's behalf (admin panel > Jobs > Post a job for a customer).
  postedByAdminId     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  bids           Bid[]
  booking        Booking?
  dispatchAlerts DispatchAlert[]
  planVisit      PlanVisit?

  @@index([status])
  @@index([geohash])
  @@index([city])
  @@index([customerId])
}

model DispatchAlert {
  id         String   @id @default(cuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  providerId String
  channels   String[] @default([])
  // How many times this pro was alerted for this job (handoff §11.5: never
  // more than twice) and whether a push actually went out (quiet hours /
  // paused / daily cap create the row without one).
  alertCount Int      @default(1)
  pushSent   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([jobId])
  @@index([providerId])
}

model Bid {
  id              String          @id @default(cuid())
  jobId           String
  job             Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  providerId      String
  provider        ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  pricePKR        Int
  etaMinutes      Int
  message         String?
  itemized        Json?
  // Display-only, informational estimate of parts/materials cost — never
  // processed, held, or referenced in any payment/commission calculation.
  // Parts money is settled directly between customer and provider, entirely
  // outside Servigic's payment flow (servigic-parts-payment-copy-changes-v1.1 §1).
  estimatedPartsNote String?
  status          BidStatus       @default(PENDING)
  declineReason   String?
  counterPricePKR Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  booking Booking?

  @@unique([jobId, providerId])
  @@index([jobId])
  @@index([providerId])
}

model Booking {
  id              String          @id @default(cuid())
  jobId           String          @unique
  job             Job             @relation(fields: [jobId], references: [id])
  bidId           String          @unique
  bid             Bid             @relation(fields: [bidId], references: [id])
  customerId      String
  customer        User            @relation("CustomerBookings", fields: [customerId], references: [id])
  providerUserId  String
  providerUser    User            @relation("ProviderBookings", fields: [providerUserId], references: [id])
  providerId      String
  providerProfile ProviderProfile @relation("ProviderProfileBookings", fields: [providerId], references: [id])
  totalPKR        Int
  commissionPKR   Int
  // Customer ad-reward discount applied to this booking (PKR). Comes out of
  // Servigic's commission, not the pro's pocket - see api/mobile/rewards.
  rewardDiscountPKR Int @default(0)
  payoutPKR       Int
  status          BookingStatus   @default(PENDING_PAYMENT)
  matchType       MatchType       @default(BID)
  // Set when an admin confirmed the winning bid on the customer's behalf.
  confirmedByAdminId String?
  // Nullable since PR#57 (v6 addendum) — only meaningful in PROTECTED
  // payment mode (72h window to submit escrow payment proof). CASH_WALLET
  // bookings go straight to CONFIRMED and never set this.
  paymentDeadline DateTime?
  timeline        Json            @default("{}")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  payment                 Payment?
  payout                  Payout?
  locationPings           LocationPing[]
  review                  Review?
  customerReview          CustomerReview?
  messages                Message[]
  dispute                 Dispute?
  changeOrders            ChangeOrder[]
  commissionLedgerEntries CommissionLedgerEntry[]
  cancellationEvent       CancellationEvent?

  @@index([status])
  @@index([customerId])
  @@index([providerUserId])
}

enum ChangeOrderStatus {
  PENDING
  DECLINED
  AWAITING_PAYMENT
  PAID
  CONFIRMED
}

// Provider proposes extra on-site work + price; customer approves and pays
// the difference into escrow before the extra work happens (Master Brief
// FAQ already promises this flow — Competitive Edge Addendum §2.3).
model ChangeOrder {
  id             String            @id @default(cuid())
  bookingId      String
  booking        Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  proposedById   String
  proposedBy     User              @relation("ChangeOrderProposer", fields: [proposedById], references: [id])
  description    String
  photoUrl       String?
  extraAmountPKR Int
  status         ChangeOrderStatus @default(PENDING)
  paymentMethod  PaymentMethod?
  proofImageUrl  String?
  verifiedAt     DateTime?
  verifiedBy     String?
  createdAt      DateTime          @default(now())
  respondedAt    DateTime?

  @@index([bookingId])
  @@index([status])
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String        @unique
  booking       Booking       @relation(fields: [bookingId], references: [id])
  amountPKR     Int
  method        PaymentMethod
  proofImageUrl String?
  status        PaymentStatus @default(SUBMITTED)
  verifiedAt    DateTime?
  verifiedBy    String?
  createdAt     DateTime      @default(now())

  @@index([status])
}

model Payout {
  id         String          @id @default(cuid())
  bookingId  String          @unique
  booking    Booking         @relation(fields: [bookingId], references: [id])
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id])
  amountPKR  Int
  method     PayoutMethod
  accountRef String?
  status     PayoutStatus    @default(QUEUED)
  sentAt     DateTime?
  adminNote  String?
  createdAt  DateTime        @default(now())

  @@index([status])
  @@index([providerId])
}

// Cash-After-Job Payment Model — Pro Commission Wallet (v6 §1.4). Under
// PAYMENT_MODE=CASH_WALLET, Servigic never holds customer money; instead the
// 12% commission becomes debt here, settled by the pro topping up. Kept
// entirely separate from Payment/Payout (PROTECTED-mode escrow), which stay
// unused-but-present so PAYMENT_MODE can be flipped back for other markets.
model ProWallet {
  id                String    @id @default(cuid())
  providerId        String    @unique
  provider          ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  balancePKR        Int       @default(0) // negative = pro owes Servigic (the common case)
  ceilingPKR        Int       @default(3000) // debt ceiling before dispatch block; admin-editable per pro
  unsettledJobCount Int       @default(0) // completed jobs with unpaid commission since balance last returned to >= 0
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  ledgerEntries CommissionLedgerEntry[]
  topUps        TopUp[]

  @@index([providerId])
}

model CommissionLedgerEntry {
  id        String          @id @default(cuid())
  walletId  String
  wallet    ProWallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type      LedgerEntryType
  amountPKR Int             // always positive; sign implied by `type` when applied to wallet balance
  bookingId String?
  booking   Booking?        @relation(fields: [bookingId], references: [id])
  topUpId   String?         @unique
  topUp     TopUp?          @relation(fields: [topUpId], references: [id])
  memo      String?
  createdAt DateTime        @default(now())

  @@index([walletId])
  @@index([bookingId])
}

model TopUp {
  id            String      @id @default(cuid())
  walletId      String
  wallet        ProWallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amountPKR     Int
  method        PaymentMethod
  proofImageUrl String?
  // The payment's transaction id (JazzCash / EasyPaisa TID or bank reference), kept upper-case. Required for every new
  // top-up so the admin can match it to the statement; a reused id is refused (the same payment cannot be claimed twice).
  reference     String?
  status        TopUpStatus @default(SUBMITTED)
  verifiedAt    DateTime?
  verifiedBy    String?
  createdAt     DateTime    @default(now())

  ledgerEntry CommissionLedgerEntry?

  @@index([status])
  @@index([walletId])
  @@index([reference])
}

// Anti-Disintermediation System — cancellation-rate engine (v7 §2.3).
// No cancel endpoint existed before this addendum; every cancellation
// (customer-, provider-, or admin/dispute-initiated) now writes one of
// these, feeding src/lib/cancellationRate.ts's rolling 30-day computation.
model CancellationEvent {
  id                        String                 @id @default(cuid())
  bookingId                 String                 @unique
  booking                   Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  cancelledById             String
  cancelledByUser           User                   @relation("CancellationActor", fields: [cancelledById], references: [id])
  cancelledByRole           CancelledByRole
  reasonCode                CancellationReasonCode
  reasonNote                String?
  // True only for CUSTOMER_PRO_ASKED_TO_CANCEL — excludes this cancellation
  // from the customer's own rate (protects the honest reporter) and pairs
  // with flaggedProviderId to auto-flag the pro for admin review.
  excludedFromCancellerRate Boolean                @default(false)
  flaggedProviderId         String?
  createdAt                 DateTime               @default(now())

  @@index([cancelledById, createdAt])
  @@index([flaggedProviderId])
}

// Anti-Disintermediation System — collusion-pair detection (v7 §2.4).
model ProviderFlag {
  id         String          @id @default(cuid())
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customerId String?
  customer   User?           @relation("ProviderFlagCustomer", fields: [customerId], references: [id])
  type       FlagType
  evidence   Json            // bookingIds / message ids / counts gathered by the detector
  status     FlagStatus      @default(OPEN)
  reviewedBy String?
  reviewNote String?
  reviewedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([providerId, status])
  @@index([type, status])
}

model LocationPing {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  authorId  String
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId  String
  target    User     @relation("ReviewTarget", fields: [targetId], references: [id])
  rating    Int
  tags      String[] @default([])
  comment   String?
  createdAt DateTime @default(now())
}

model CustomerReview {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  authorId  String
  author    User     @relation("CustomerReviewAuthor", fields: [authorId], references: [id])
  targetId  String
  target    User     @relation("CustomerReviewTarget", fields: [targetId], references: [id])
  rating    Int
  tags      String[] @default([])
  comment   String?
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  body      String
  // v7 §2.2/§2.4 — true iff scrubContactInfo() actually redacted something
  // in this message's body (staged-reveal masking). Feeds the
  // CONTACT_LEAKAGE_ATTEMPTS collusion heuristic in src/lib/collusionDetection.ts.
  scrubHit  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  linkUrl   String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

model Lead {
  id           String     @id @default(cuid())
  businessName String
  personName   String?
  phone        String     @unique
  whatsapp     String?
  trade        Trade
  city         String
  areaLabel    String?
  rating       Float?
  source       LeadSource @default(MANUAL)
  status       LeadStatus @default(NEW)
  outreachLog  Json       @default("[]")
  callbackDate DateTime? // next follow-up
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Zones & leads spec: where the lead is, what he does, how we got him, and whether we may contact him.
  countryCode     String    @default("PK")
  cityId          String?
  areaId          String?
  zoneId          String? // computed from the pin (Market id)
  areaRaw         String? // the text as it arrived, before matching
  addressText     String?
  lat             Float?
  lng             Float?
  trades          Trade[]   @default([])
  skills          String?
  experienceYears Int?
  altPhone        String?
  whatsappSame    Boolean   @default(true)
  sourceDetail    String?
  sources         String[]  @default([]) // every source that ever supplied this phone
  language        String?
  consent         String    @default("unknown") // unknown | yes | no
  consentAt       DateTime?
  doNotContact    Boolean   @default(false)
  ownerId         String?
  proUserId       String? // set once he registers in the Pro app
  refCode         String?   @unique // carried by his join link
  lastContactedAt DateTime?

  @@index([status])
  @@index([trade, city])
  @@index([areaId])
  @@index([zoneId])
  @@index([countryCode])
  @@index([callbackDate])
  @@index([doNotContact])
}

// One row per contact attempt / status change on a lead (who did what, when).
model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  adminId   String?
  adminName String?
  kind      String // CALL | WHATSAPP | NOTE | STATUS | SYSTEM | IMPORT
  outcome   String?
  note      String?
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

// Every export of personal data: who, when, which filter, how many rows.
model ExportAudit {
  id        String   @id @default(cuid())
  adminId   String
  adminName String
  resource  String // leads | pros | waitlist
  format    String // csv | xlsx
  filter    Json
  columns   String[]
  rowCount  Int
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SavedFilter {
  id        String   @id @default(cuid())
  adminId   String
  resource  String
  name      String
  filter    Json
  createdAt DateTime @default(now())

  @@index([adminId, resource])
}

// Remembered column mapping for an import source (OLX file, market-visit sheet...).
model ImportMapping {
  id        String   @id @default(cuid())
  name      String   @unique
  mapping   Json
  updatedAt DateTime @updatedAt
}

// Location master data: country (LocaleConfig) -> city -> area. Area names and aliases are what free-text
// addresses are matched against.
model City {
  id          String  @id @default(cuid())
  countryCode String
  name        String
  lat         Float?
  lng         Float?
  status      String  @default("waitlist") // hidden | waitlist | live

  areas Area[]

  @@unique([countryCode, name])
}

model Area {
  id      String   @id @default(cuid())
  cityId  String
  city    City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name    String
  aliases String[] @default([])
  lat     Float?
  lng     Float?
  polygon Json?
  status  String   @default("waitlist")

  @@unique([cityId, name])
  @@index([cityId])
}

// Waitlist capture only for now — Competitive Edge Addendum §2.7/§3.6:
// full property-manager role, bulk job posting, and consolidated invoicing
// are scoped as a separate future GTM motion, not a launch deliverable.
model BusinessWaitlistEntry {
  id          String   @id @default(cuid())
  companyName String
  contactName String
  phone       String
  email       String?
  unitCount   Int?
  city        String?
  notes       String?
  createdAt   DateTime @default(now())
}

model Dispute {
  id         String             @id @default(cuid())
  bookingId  String             @unique
  booking    Booking            @relation(fields: [bookingId], references: [id])
  openedById String
  openedBy   User               @relation("DisputeOpener", fields: [openedById], references: [id])
  reason     String
  photos     String[]           @default([])
  resolution DisputeResolution?
  resolvedBy String?
  notes      String?
  createdAt  DateTime           @default(now())
  resolvedAt DateTime?
}

model SiteSettings {
  id                    String   @id @default("singleton")
  // Pro documents: days before expiry to remind the pro (comma list), days allowed after expiry before job access is
  // paused, and which document types are mandatory (comma list of ID, POLICE, LICENSE, CERTIFICATE, INSURANCE, OTHER).
  docAlertDays          String   @default("30,14,7")
  docGraceDays          Int      @default(7)
  docMandatoryTypes     String   @default("ID")
  activeTheme           String   @default("electric-amber")
  defaultCommissionPct  Float    @default(12)
  whatsappSupportNumber String?
  // YouTube URL or bare video ID for the two landing-page "how it works"
  // demo clips (customer posting a job / pro accepting a bid).
  demoVideoCustomerUrl  String?
  demoVideoProUrl       String?
  featureFlags          Json     @default("{}")
  // Default ProWallet.ceilingPKR for newly created wallets (v6 §1.4) — admin
  // can still override per-pro afterward via /admin/wallets/[id].
  defaultWalletCeilingPKR Int    @default(3000)
  // Early-pro incentive: first N completed jobs commission-free for pros
  // activated while their market is PILOT (0 = off).
  earlyProFreeJobs        Int    @default(0)
  // Job alerts go to the nearest N matching pros (handoff §11.5).
  alertNearestN           Int    @default(12)
  // Customer is told their job has no bids after this many minutes (§11.2).
  noBidsAfterMin          Int    @default(20)
  // Referral programme (all amounts in PKR; off until an admin switches it on).
  referralsEnabled          Boolean @default(false)
  referralCustomerCreditPKR Int     @default(200) // booking credit for a referring customer
  referralProBonusPKR       Int     @default(300) // commission credit for a referring pro
  referralProJobsRequired   Int     @default(3)   // jobs a referred pro must complete before the referrer is rewarded
  referralNewProFreeJobs    Int     @default(3)   // a referred pro pays 0% commission on their first N jobs
  referralNewCustomerDiscountPKR Int @default(200) // off a referred customer's first qualifying job
  referralNewCustomerMinJobPKR   Int @default(1000) // minimum job value for that discount
  // Pro service radius slider limits (km) and the cap on trades per pro.
  proRadiusMinKm            Int     @default(2)
  proRadiusMaxKm            Int     @default(15)
  proRadiusDefaultKm        Int     @default(5)
  maxTradesPerPro           Int     @default(3)
  // Where pros send money to top up their wallet (shown inside the Pro app's top-up sheet). Empty = fall back to the
  // NEXT_PUBLIC_* payment numbers in the environment; placeholder values like 0000 are never shown.
  payJazzcashNumber         String?
  payJazzcashTitle          String?
  payEasypaisaNumber        String?
  payEasypaisaTitle         String?
  payBankName               String?
  payBankAccountTitle       String?
  payBankAccountNumber      String?
  // Remote app controls (admin Settings), so these never need an app release:
  announcementActive        Boolean @default(false)
  announcementTitle         String?
  announcementBody          String?
  announcementAudience      String  @default("ALL") // ALL | CUSTOMER | PROVIDER
  minAndroidVersionCode     Int     @default(0)     // apps older than this show "please update" (0 = off)
  storeUrlPro               String?
  storeUrlCustomer          String?
  minTopUpPKR               Int     @default(500)
  // Pre-launch (Admin > Settings; env PRO_APP_LIVE / CUSTOMER_APP_LIVE / PRO_TESTER_GROUP_URL ... are the fallback)
  proAppLive                Boolean @default(false)
  customerAppLive           Boolean @default(false)
  proTesterGroupUrl         String?
  proTestingOptInUrl        String?
  customerPreregUrl         String?
  signupNotifyEmail         String? // who gets an email on every waitlist signup
  // Founding Pro: the first N approved pros in the city pay foundingProPct instead of the standard rate for N months
  foundingProSlots          Int     @default(100)
  foundingProPct            Float   @default(10)
  foundingProMonths         Int     @default(3)
  foundingProCity           String  @default("Karachi")
  updatedAt             DateTime @updatedAt
}

// Privacy-friendly website analytics for the landing page's live-visitor panel.
// One row per visitor per day: `visitorHash` is sha256(daily-rotating salt +
// IP + user-agent), so no cookie is set and the hash can't be linked across
// days or reversed to an IP. Only the country (from the platform geo header)
// is kept.
model SiteVisitor {
  id          String   @id @default(cuid())
  day         String // UTC date, "YYYY-MM-DD"
  visitorHash String
  country     String   @default("XX") // ISO 3166-1 alpha-2, "XX" = unknown
  pageViews   Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([day, visitorHash])
  @@index([lastSeenAt])
  @@index([country])
}

// Display-only FX rates, admin-editable (no paid FX API wired). Rate is
// "units of this currency per 1 PKR" — e.g. USD rate 0.0036 means
// PKR 1,000 displays as ~$3.60.
model ExchangeRate {
  currency   Currency @id
  ratePerPKR Float
  updatedAt  DateTime @updatedAt
}

// Geo-Localized Landing Page Addendum v5 — one admin-editable row per
// country, replacing the hardcoded COUNTRY_MARKETS map in geoDetect.ts.
// Deliberately does NOT duplicate an exchange rate here — currency is
// shared across countries (DE/AT/CH all use EUR) so the rate stays owned
// by ExchangeRate.currency, joined via this row's `currency` field.
model LocaleConfig {
  countryCode         String   @id // ISO 3166-1 alpha-2, e.g. "PK"
  countryName         String
  language            Language @default(en)
  direction           String   @default("ltr") // "ltr" | "rtl"
  currency            Currency @default(PKR)
  paymentMethodsShown String[] @default([])
  legalDisclaimer     String   @default("")
  isLive              Boolean  @default(false)
  citiesLive          String[] @default([])
  // hidden (no sign-ups) | waitlist (sign-ups and leads only) | live (zones can go live)
  marketStatus        String   @default("waitlist")
  updatedAt           DateTime @updatedAt
}

// Country-level "notify me when you launch here" capture for LocaleConfig
// rows with isLive = false — distinct from BusinessWaitlistEntry (that one
// is B2B property-manager-specific with different required fields).
model CountryWaitlistEntry {
  id          String   @id @default(cuid())
  countryCode String
  email       String?
  name        String?
  city        String?
  // Market config (handoff §11.6): which trade / zone / role the person is waiting for.
  phone       String?
  trade       Trade?
  zone        String?
  role        String?
  userId      String?
  // Where they were when they asked (GPS or job pin) and the zone that later covered it.
  lat         Float?
  lng         Float?
  area        String?
  marketId    String?
  // Set when we told them their zone opened (push / SMS), so nobody is messaged twice.
  notifiedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([countryCode])
  @@index([trade])
  @@index([marketId])
}

enum MarketStatus {
  WAITLIST
  PILOT
  LIVE
}

enum ProActivation {
  ACTIVE
  WAITING
}

// Market configuration (handoff §11.6). One row per launch area: a zone or a
// whole country. `cities` is how a job/user city maps to its market. A market
// accepts jobs only while enabled AND status is PILOT or LIVE; which trades are
// offered is the per-trade matrix (MarketCategory).
model Market {
  id          String         @id @default(cuid())
  countryCode String // ISO 3166-1 alpha-2
  name        String // zone or area label, e.g. "Karachi" or "Canada"
  cities      String[]       @default([])
  enabled     Boolean        @default(false)
  status      MarketStatus   @default(WAITLIST)
  currency    Currency       @default(PKR)
  phoneCode   String         @default("+92")
  timezone    String         @default("Asia/Karachi")
  // Geofence drawn on the admin map: an array of polygons, each an array of [lat, lng] points. When present, a
  // job/GPS point belongs to this zone only if it falls inside one of them (city names are then ignored).
  polygons    Json?
  launchDate  DateTime?
  // Wallet debt ceiling / smallest top-up in this market's own currency. Blank = worked out automatically from the Pakistani numbers
  // in Settings (see src/lib/walletLimits.ts).
  walletCeiling Int?
  minTopUp      Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  categories MarketCategory[]

  @@unique([countryCode, name])
}

model MarketCategory {
  id            String  @id @default(cuid())
  marketId      String
  market        Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)
  trade         Trade
  enabled       Boolean @default(true)
  // Admin cap on ACTIVE pros for this trade in this market (null = no cap).
  maxActivePros Int?
  // Recruiting goal for this zone and trade (the zone dashboard shows active Pros against it).
  targetPros    Int     @default(10)

  @@unique([marketId, trade])
}

// ─────────────────────────────────────────────────────────────────────────
// Accounting — double-entry bookkeeping (Chart of Accounts, General Journal,
// General Ledger). All amounts are whole PKR, matching every other money
// field in this schema. Auto-posted on payment verification, payout
// mark-sent, and dispute full-refund resolution (see src/lib/accounting/);
// admins can also post manual entries directly from /admin/accounting.
// ─────────────────────────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Account {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  type      AccountType
  isSystem  Boolean     @default(false) // system accounts are used by auto-posting and can't be deleted
  createdAt DateTime    @default(now())

  lines JournalLine[]
}

model JournalEntry {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  memo        String
  source      String // "AUTO_PAYMENT_VERIFIED" | "AUTO_PAYOUT_SENT" | "AUTO_DISPUTE_REFUND" | "MANUAL"
  referenceId String? // bookingId / paymentId / payoutId / disputeId for auto entries
  createdById String?
  createdBy   User?    @relation("JournalEntryPoster", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  lines JournalLine[]

  @@index([date])
  @@index([source])
}

model JournalLine {
  id        String       @id @default(cuid())
  entryId   String
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account   Account      @relation(fields: [accountId], references: [id])
  debitPKR  Int          @default(0)
  creditPKR Int          @default(0)
  createdAt DateTime     @default(now())

  @@index([accountId])
  @@index([entryId])
}

// Customer rewarded-ad credit: "watch an ad, get a flat PKR 50 off the next
// completed booking". Enforced server-side: max 2 earned per customer per
// rolling 7 days, one credit consumed per booking, never stackable.
model RewardCredit {
  id         String    @id @default(cuid())
  customerId String
  customer   User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind       String    @default("AD_DISCOUNT")
  amountPKR  Int       @default(50)
  earnedAt   DateTime  @default(now())
  consumedAt DateTime?
  bookingId  String?

  @@index([customerId, earnedAt])
  @@index([customerId, consumedAt])
}


enum ReferralStatus {
  PENDING // signed up with a code, reward not earned yet
  RELEASED // reward paid out
  REJECTED // blocked as abuse (self-referral, repeat device / phone) or cancelled by an admin
}

// One row per referred person. The reward is released only when the referred person has actually done
// the work: a customer's first completed job, or a pro's Nth completed job (see src/lib/referrals.ts).
model Referral {
  id                String         @id @default(cuid())
  referrerId        String
  referredUserId    String         @unique
  role              Role // role of the referred person (CUSTOMER or PROVIDER)
  status            ReferralStatus @default(PENDING)
  // Reward amounts are frozen at signup so later admin edits do not change what was promised.
  referrerRole      Role           @default(CUSTOMER)
  referrerRewardPKR Int
  refereeRewardPKR  Int            @default(0) // new customer: discount off the first qualifying job
  minJobPKR         Int            @default(0) // minimum job value for that discount
  freeJobsGranted   Int            @default(0) // new pro: commission-free jobs granted at signup
  discountBookingId String? // the booking the new customer's discount was applied to
  jobsRequired      Int            @default(1)
  rejectReason      String?
  deviceId          String?
  phoneKey          String // digits-only phone, kept so deleting and re-creating an account cannot be referred twice
  releasedAt        DateTime?
  createdAt         DateTime       @default(now())

  @@index([referrerId])
  @@index([status])
  @@index([deviceId])
  @@index([phoneKey])
}


enum TradeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// A pro's request to work in a trade. ProviderProfile.trades holds only APPROVED trades (everything that
// matches pros to jobs reads that array), so a trade becomes active only when an admin approves it here.
model ProviderTrade {
  id                   String             @id @default(cuid())
  providerId           String
  provider             ProviderProfile    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  trade                Trade
  status               TradeRequestStatus @default(PENDING)
  // Admin asked for a certificate / photo (e.g. gas, electrical, AC) before deciding.
  certificateRequested Boolean            @default(false)
  certificateUrl       String?
  adminNote            String?
  requestedAt          DateTime           @default(now())
  reviewedAt           DateTime?

  @@unique([providerId, trade])
  @@index([status])
}


// Pre-launch waitlist (website). One row per WhatsApp number; signing up again updates the row. No IP address is
// stored: the visitor's country/region come from the hosting edge header and only that result is kept.
model WaitlistSignup {
  id               String    @id @default(cuid())
  role             String // CUSTOMER | PROVIDER
  name             String
  whatsapp         String    @unique // E.164
  countryCode      String // chosen by the visitor (pre-filled from the connection)
  detectedCountry  String?
  detectedRegion   String?
  city             String?
  area             String?
  email            String?
  trade            String?
  experienceYears  Int?
  gmail            String?
  language         String
  sourcePage       String?
  utm              Json?
  referredByCode   String?
  referralCode     String    @unique
  consentAt        DateTime
  launchMessageSentAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([role])
  @@index([countryCode])
  @@index([createdAt])
  @@index([referredByCode])
}

// Small DB-backed rate limiter (sign-up, password reset, chat): one row per hit, counted over a time window.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// Chatbot answers that were not in the FAQ/site content. A question asked more than once is answered from here, never by a
// new AI call; unanswered questions (source "none") show up in the admin list so the FAQ can grow.
model ChatAnswer {
  id          String   @id @default(cuid())
  lang        String
  qHash       String
  question    String
  answer      String?
  source      String // "ai" | "none"
  hits        Int      @default(1)
  createdAt   DateTime @default(now())
  lastAskedAt DateTime @default(now())

  @@unique([lang, qHash])
  @@index([source, hits])
}

// Every acceptance (e-signature) of the Customer Terms / Pro Agreement: who, which version and exact text (hash + full
// copy), when, from which IP and device, in which country. Kept as evidence for complaints and legal claims.
model TermsAcceptance {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role
  document     String // CUSTOMER_TERMS | PRO_AGREEMENT
  country      String
  version      String
  docHash      String
  documentText String   @db.Text
  signedName   String
  ip           String?
  userAgent    String?
  locale       String?
  source       String // web | app
  acceptedAt   DateTime @default(now())

  @@index([userId, document])
}

// A pro's identity documents, certificates, licences and insurance, with their expiry dates. Every new or replacement
// document waits for admin approval (PENDING); when approved it replaces the previous one (SUPERSEDED).
model ProviderDocument {
  id             String          @id @default(cuid())
  providerId     String
  provider       ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  type           String // ID | POLICE | LICENSE | CERTIFICATE | INSURANCE | OTHER
  label          String
  fileUrl        String
  expiresAt      DateTime?
  status         String          @default("PENDING") // PENDING | APPROVED | REJECTED | SUPERSEDED
  rejectReason   String?
  submittedAt    DateTime        @default(now())
  reviewedAt     DateTime?
  reviewedById   String?
  // Last expiry reminder sent ("30", "14", "7", "0" = on the day, "grace" = access paused).
  lastExpiryAlert String?

  @@index([providerId, status])
  @@index([status, expiresAt])
}
